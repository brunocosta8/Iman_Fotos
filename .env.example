# Copiar para .env.local para desenvolvimento local (npm run dev).
# Estes valores são públicos por natureza (a anon key é protegida pelo RLS).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...ou...sb_publishable_...
# URL público do bucket R2 (r2.dev ou domínio próprio), sem barra no fim
VITE_MEDIA_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
